# ─── Supabase / PostgreSQL ────────────────────────────────────────────────────
# DATABASE_URL — transaction-mode pooler (port 6543), used by the runtime app
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL — session-mode pooler (port 5432), used by prisma db push / migrations
# Note: @/@ and special chars in password must be URL-encoded (@ → %40)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres"

# ─── Auth ─────────────────────────────────────────────────────────────────────
SESSION_SECRET="change-me-32-char-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-nextauth-secret"

# ─── Plaid ────────────────────────────────────────────────────────────────────
PLAID_CLIENT_ID="your-plaid-client-id"
PLAID_SECRET="your-plaid-secret"
PLAID_ENV="sandbox"

# ─── Encryption (for Plaid tokens at rest) ───────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="your-64-char-hex-encryption-key"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
