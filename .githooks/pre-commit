#!/usr/bin/env bash
# Pre-commit hook — blocks service account keys and Firebase credentials.
# Checks both filename patterns and JSON file contents so renamed files
# are caught regardless of what they're called.
#
# Install: git config core.hooksPath .githooks
# (automatically done by `npm run prepare`)

set -euo pipefail

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
[ -z "$STAGED_FILES" ] && exit 0

# Filename patterns to block (case-insensitive via tr)
BLOCKED_NAME_PATTERNS=(
  "*firebase-adminsdk*"
  "*firebase-*.json"
  "*service-account*.json"
  "*service_account*.json"
  "*-credentials.json"
  "firebase-service-account.json"
)

bail() {
  printf '\n\033[31m✗ COMMIT BLOCKED — potential secret detected\033[0m\n'
  printf '  File : %s\n' "$1"
  printf '  Reason: %s\n' "$2"
  printf '\n  To unstage: git rm --cached "%s"\n' "$1"
  printf '  Then add the file to .gitignore if needed.\n\n'
  exit 1
}

for staged_file in $STAGED_FILES; do
  base=$(basename "$staged_file")

  # ── 1. Block by filename pattern ──────────────────────────────────────────
  for pattern in "${BLOCKED_NAME_PATTERNS[@]}"; do
    case "$base" in
      $pattern)
        bail "$staged_file" "filename matches blocked pattern: $pattern"
        ;;
    esac
  done

  # ── 2. Block any JSON whose content declares service_account ──────────────
  if [[ "$staged_file" == *.json ]]; then
    if git show ":${staged_file}" 2>/dev/null \
        | grep -q '"type"[[:space:]]*:[[:space:]]*"service_account"'; then
      bail "$staged_file" 'file contains "type": "service_account" — GCP/Firebase service account key'
    fi
  fi
done

exit 0
