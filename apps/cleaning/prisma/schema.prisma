// Cleaning ERP — Prisma schema
//
// Conservative Phase 0 foundation + the immediately-following field-work spine
// (customers → locations → service plans → jobs → assignments → checklists →
// time tracking). Deferred on purpose (added in their own phases, NOT here):
// inspections, issues/corrective-actions, invoicing, leads/estimates, vendors,
// assets, procurement, and all Business/Enterprise-tier entities.
//
// All models live under the dedicated `cleaning` Postgres schema (multiSchema),
// mirroring the hce-books precedent, so this database can be physically
// co-located later at zero migration cost. This database is SEPARATE from
// Relay's — there are no cross-app foreign keys, ever.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["cleaning"]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  SUPERVISOR
  CLEANER

  @@schema("cleaning")
}

// Commercial package. Employee counts are advisory only — capability access is
// derived from this tier plus per-org overrides (see src/lib/entitlements).
enum PackageTier {
  SOLO
  TEAM
  BUSINESS
  ENTERPRISE

  @@schema("cleaning")
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED

  @@schema("cleaning")
}

// Timekeeping/labor-cost classification only. We do NOT process payroll, taxes,
// or direct deposit — external providers do. This drives labor-cost math and
// future payroll EXPORT only.
enum PayType {
  HOURLY
  SALARY

  @@schema("cleaning")
}

enum ServiceFrequency {
  ONE_TIME
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM

  @@schema("cleaning")
}

enum JobStatus {
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED

  @@schema("cleaning")
}

enum AssignmentStatus {
  ASSIGNED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  DECLINED

  @@schema("cleaning")
}

enum TimeEntryStatus {
  OPEN
  COMPLETED
  APPROVED
  REJECTED

  @@schema("cleaning")
}

// ─── Tenant + identity ───────────────────────────────────────────────────────

// ─── Contracts / service agreements (Phase 8) ────────────────────────────────

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED

  @@schema("cleaning")
}

// How the agreement is billed — informational cadence. Invoicing still generates
// from jobs/service plans; a contract is NOT a billing source.
enum ContractBillingFrequency {
  MONTHLY
  QUARTERLY
  ANNUALLY
  ONE_TIME

  @@schema("cleaning")
}

// ─── Assets & supplies (Phase 6) ─────────────────────────────────────────────

enum AssetCategory {
  EQUIPMENT
  VEHICLE
  MACHINE

  @@schema("cleaning")
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  RETIRED

  @@schema("cleaning")
}

// ─── CRM: leads & estimates (Phase 5) ────────────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  ESTIMATING
  WON
  LOST

  @@schema("cleaning")
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED

  @@schema("cleaning")
}

// Pricing shape of an estimate, mapped to a ServicePlan billingType on convert.
enum EstimatePricing {
  PER_VISIT // → FLAT_PER_JOB
  HOURLY // → HOURLY

  @@schema("cleaning")
}

// ─── Billing (Phase 2) ───────────────────────────────────────────────────────

enum BillingType {
  FLAT_PER_JOB
  HOURLY

  @@schema("cleaning")
}

enum PaymentTerms {
  DUE_ON_RECEIPT
  NET_15
  NET_30

  @@schema("cleaning")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID

  @@schema("cleaning")
}

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  // Entitlements: tier + per-org overrides. Product code resolves capabilities
  // from these via canUse(); it must never branch on the tier directly.
  packageTier         PackageTier @default(TEAM)
  capabilityOverrides Json? // { "add": string[], "remove": string[] }

  onboardingCompletedAt DateTime?
  trialEndsAt           DateTime?
  // Dashboard warning lead time for expiring contracts (Phase 8), configurable.
  contractExpiryLeadDays Int @default(60)
  subscriptionStatus    String    @default("trialing") // trialing | active | past_due | canceled
  // Default IANA timezone for scheduling. Service locations may override.
  timezone              String    @default("America/New_York")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  customers          Customer[]
  serviceLocations   ServiceLocation[]
  checklistTemplates ChecklistTemplate[]
  servicePlans       ServicePlan[]
  jobs               Job[]
  timeEntries        TimeEntry[]
  auditEvents        AuditEvent[]
  jobPhotos          JobPhoto[]
  issues             Issue[]
  inspectionTemplates InspectionTemplate[]
  inspections         Inspection[]
  invoices            Invoice[]
  leads               Lead[]
  estimates           Estimate[]
  assets              Asset[]
  supplies            Supply[]
  supplyUsages        SupplyUsage[]
  contracts           Contract[]

  @@schema("cleaning")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  password       String
  role           UserRole @default(CLEANER)
  phone          String?
  isActive       Boolean  @default(true)
  organizationId String
  managerId      String?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager         User?            @relation("UserHierarchy", fields: [managerId], references: [id])
  reports         User[]           @relation("UserHierarchy")
  employeeProfile EmployeeProfile?
  jobAssignments  JobAssignment[]
  timeEntries     TimeEntry[]      @relation("TimeEntryWorker")
  approvedTimeEntries TimeEntry[]  @relation("TimeEntryApprover")
  createdJobs     Job[]            @relation("JobCreatedBy")
  uploadedPhotos  JobPhoto[]       @relation("PhotoUploader")
  reportedIssues  Issue[]          @relation("IssueReporter")
  assignedIssues  Issue[]          @relation("IssueAssignee")
  issueComments   IssueComment[]   @relation("IssueCommentAuthor")
  inspections     Inspection[]     @relation("InspectionInspector")
  assignedLeads   Lead[]           @relation("LeadAssignee")
  assignedAssets       Asset[]            @relation("AssetUser")
  performedMaintenance AssetMaintenance[] @relation("MaintenancePerformer")
  recordedSupplyUsages SupplyUsage[]      @relation("SupplyUsageRecorder")
  supplyAdjustments    SupplyAdjustment[] @relation("SupplyAdjuster")
  passwordResetTokens PasswordResetToken[]

  @@index([organizationId])
  @@schema("cleaning")
}

// HR / labor-cost data kept off the auth row. Cleaners are Users (they log in);
// this 1:1 profile carries employment + pay-rate data used for labor costing
// and future payroll EXPORT only — never for payroll processing.
model EmployeeProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  organizationId   String
  employeeCode     String?
  payType          PayType          @default(HOURLY)
  payRate          Decimal?         @db.Decimal(10, 2)
  employmentStatus EmploymentStatus @default(ACTIVE)
  hireDate         DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@schema("cleaning")
}

// ─── Customers + sites ───────────────────────────────────────────────────────

model Customer {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  primaryContactName String?
  email              String?
  phone              String?
  billingAddress     String?
  billingEmail       String?
  paymentTerms       PaymentTerms @default(DUE_ON_RECEIPT)
  notes              String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts         Contact[]
  serviceLocations ServiceLocation[]
  invoices         Invoice[]
  estimates              Estimate[] @relation("EstimateCustomer")
  convertedFromEstimates Estimate[] @relation("EstimateConvertedCustomer")
  contracts        Contract[]

  @@index([organizationId])
  @@schema("cleaning")
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  name           String
  title          String?
  email          String?
  phone          String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@schema("cleaning")
}

model ServiceLocation {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?  @default("US")
  // Geolocation is captured for future geofenced clock-in. The radius is stored
  // so enforcement can be turned on later; Phase 0 does NOT enforce geofencing.
  latitude        Float?
  longitude       Float?
  geofenceRadiusM Int?
  // IANA timezone override for this site; falls back to Organization.timezone.
  timezone        String?
  // Site contact, used when different from the customer's primary contact.
  siteContactName  String?
  siteContactPhone String?
  siteContactEmail String?
  parentId       String?
  // Access instructions / site notes (gate codes, alarm, parking, etc.).
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  parent       ServiceLocation?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children     ServiceLocation[] @relation("LocationHierarchy")
  servicePlans ServicePlan[]
  jobs         Job[]
  issues       Issue[]
  inspections  Inspection[]
  assets       Asset[]       @relation("AssetSite")
  supplyUsages SupplyUsage[] @relation("SupplyUsageSite")

  @@index([organizationId])
  @@index([customerId])
  @@schema("cleaning")
}

// ─── Scope of work + recurring service ───────────────────────────────────────

model ChecklistTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  version        Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ChecklistTemplateItem[]
  servicePlans ServicePlan[]
  estimates    Estimate[]

  @@index([organizationId])
  @@schema("cleaning")
}

model ChecklistTemplateItem {
  id           String   @id @default(cuid())
  templateId   String
  label        String
  instructions String?
  sortOrder    Int      @default(0)
  isRequired   Boolean  @default(true)
  requirePhoto Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@schema("cleaning")
}

model ServicePlan {
  id                 String           @id @default(cuid())
  organizationId     String
  serviceLocationId  String
  name               String
  frequency          ServiceFrequency @default(WEEKLY)
  rrule              String? // iCal RRULE string for CUSTOM cadences (never shown raw to users)
  startTime          String?          // local wall-clock "HH:mm" in the site timezone
  crewSize           Int              @default(1)
  defaultDurationMin Int?
  checklistTemplateId String?
  startDate          DateTime?
  endDate            DateTime?
  // Billing (Phase 2). rate is per-job for FLAT_PER_JOB, per-hour for HOURLY.
  billingType        BillingType      @default(FLAT_PER_JOB)
  rate               Decimal?         @db.Decimal(12, 2)
  currency           String           @default("USD")
  contractId         String? // OPTIONAL link to a commercial contract (Phase 8)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceLocation   ServiceLocation    @relation(fields: [serviceLocationId], references: [id], onDelete: Cascade)
  checklistTemplate ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id])
  contract          Contract?          @relation(fields: [contractId], references: [id])
  jobs              Job[]

  @@index([organizationId])
  @@index([serviceLocationId])
  @@index([contractId])
  @@schema("cleaning")
}

// ─── Jobs (scheduled work) + assignment + per-job checklist ──────────────────

model Job {
  id                String    @id @default(cuid())
  organizationId    String
  serviceLocationId String
  servicePlanId     String?
  title             String
  status            JobStatus @default(SCHEDULED)
  scheduledStart    DateTime
  scheduledEnd      DateTime?
  crewSize          Int?      // required/default crew size (copied from the plan)
  actualStart       DateTime?
  actualEnd         DateTime?
  notes             String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceLocation ServiceLocation    @relation(fields: [serviceLocationId], references: [id], onDelete: Cascade)
  servicePlan     ServicePlan?       @relation(fields: [servicePlanId], references: [id])
  createdBy       User?              @relation("JobCreatedBy", fields: [createdById], references: [id])
  assignments     JobAssignment[]
  checklistItems  JobChecklistItem[]
  timeEntries     TimeEntry[]
  photos          JobPhoto[]
  issues          Issue[]
  inspections     Inspection[]
  invoiceLines    InvoiceLine[]
  supplyUsages    SupplyUsage[]

  // Idempotent generation: a plan can produce at most one Job per occurrence
  // start. Manual jobs have servicePlanId = NULL, which Postgres treats as
  // distinct, so they never collide here.
  @@unique([servicePlanId, scheduledStart])
  @@index([organizationId])
  @@index([serviceLocationId])
  @@index([status])
  @@index([scheduledStart])
  @@schema("cleaning")
}

model JobAssignment {
  id             String           @id @default(cuid())
  organizationId String
  jobId          String
  userId         String
  status         AssignmentStatus @default(ASSIGNED)
  assignedAt     DateTime         @default(now())
  acknowledgedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([organizationId])
  @@index([userId])
  @@schema("cleaning")
}

model JobChecklistItem {
  id            String   @id @default(cuid())
  jobId         String
  label         String
  instructions  String?
  sortOrder     Int      @default(0)
  isRequired    Boolean  @default(true)
  requirePhoto  Boolean  @default(false)
  isComplete    Boolean  @default(false)
  completedAt   DateTime?
  completedById String?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  job    Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  photos JobPhoto[]

  @@index([jobId])
  @@schema("cleaning")
}

// ─── Time tracking (geolocation-ready, geofence NOT enforced yet) ────────────

model TimeEntry {
  id             String          @id @default(cuid())
  organizationId String
  jobId          String?
  userId         String
  status         TimeEntryStatus @default(OPEN)

  clockInAt        DateTime
  clockInLat       Float?
  clockInLng       Float?
  clockInAccuracyM Float?
  clockInSource    String? // "mobile_gps" | "manual" | "kiosk"

  clockOutAt        DateTime?
  clockOutLat       Float?
  clockOutLng       Float?
  clockOutAccuracyM Float?
  clockOutSource    String?

  breakMinutes Int      @default(0)
  approvedById String?
  approvedAt   DateTime?
  // Snapshot of the worker's pay basis at APPROVAL time so later raises never
  // rewrite historical labor cost (same snapshot pattern as invoice lines).
  approvedPayRate Decimal? @db.Decimal(10, 2)
  approvedPayType String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("TimeEntryWorker", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("TimeEntryApprover", fields: [approvedById], references: [id])
  job          Job?         @relation(fields: [jobId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([jobId])
  @@schema("cleaning")
}

// ─── Generic audit trail (the one liftable piece of Relay's IssueHistory) ────

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  entityType     String
  entityId       String
  action         String
  field          String?
  oldValue       String?
  newValue       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@schema("cleaning")
}

// ─── Proof of service (photos) ───────────────────────────────────────────────
// Tenant-scoped photo records. Bytes live in object storage (see src/lib/storage);
// this row holds the storage key + metadata (uploader, timestamp, size, type).
// Deliberately NOT coupled to Relay's Issue model — Cleaning owns its own Issue.
model JobPhoto {
  id                     String   @id @default(cuid())
  organizationId         String
  // jobId is nullable so inspection/issue photos not tied to one exact Job work.
  jobId                  String?
  jobChecklistItemId     String?
  issueId                String?
  inspectionId           String?
  inspectionItemResultId String?
  storageKey             String
  contentType            String
  sizeBytes              Int
  uploadedById           String
  caption                String?
  createdAt              DateTime @default(now())

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                  Job?                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  checklistItem        JobChecklistItem?     @relation(fields: [jobChecklistItemId], references: [id], onDelete: SetNull)
  issue                Issue?                @relation(fields: [issueId], references: [id], onDelete: SetNull)
  inspection           Inspection?           @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionItemResult InspectionItemResult? @relation(fields: [inspectionItemResultId], references: [id], onDelete: SetNull)
  uploadedBy           User                  @relation("PhotoUploader", fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([jobId])
  @@index([jobChecklistItemId])
  @@index([inspectionId])
  @@schema("cleaning")
}

// ─── Cleaning Issue (field problem reports) ──────────────────────────────────
// The long-term Cleaning Issue model, intentionally introduced now in a minimal
// shape (field "Report a Problem"). Phase 5 EXPANDS this (assignment, escalation,
// corrective actions, resolution) — it does not replace it. Not Relay's Issue.
enum IssueCategory {
  QUALITY
  SAFETY
  EQUIPMENT
  SUPPLIES
  ACCESS
  CUSTOMER
  OTHER

  @@schema("cleaning")
}

enum IssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CLOSED

  @@schema("cleaning")
}

model Issue {
  id                String        @id @default(cuid())
  organizationId    String
  jobId             String?
  serviceLocationId String?
  inspectionId      String?       @unique // at most one Issue per inspection (idempotent finalize)
  reportedById      String
  assignedToId      String?
  category          IssueCategory @default(OTHER)
  title             String?
  description       String
  status            IssueStatus   @default(OPEN)
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job             Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  serviceLocation ServiceLocation? @relation(fields: [serviceLocationId], references: [id], onDelete: SetNull)
  inspection      Inspection?      @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  reportedBy      User             @relation("IssueReporter", fields: [reportedById], references: [id])
  assignedTo      User?            @relation("IssueAssignee", fields: [assignedToId], references: [id])
  comments        IssueComment[]
  photos          JobPhoto[]

  @@index([organizationId])
  @@index([jobId])
  @@index([status])
  @@schema("cleaning")
}

model IssueComment {
  id             String   @id @default(cuid())
  organizationId String
  issueId        String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation("IssueCommentAuthor", fields: [authorId], references: [id])

  @@index([issueId])
  @@index([organizationId])
  @@schema("cleaning")
}

// Password reset tokens — accessed by token BEFORE authentication, so this is
// intentionally NOT organization-scoped. Only a SHA-256 hash of the token is
// stored; the raw token lives only in the emailed link and is single-use.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("cleaning")
}

// ─── Inspections (quality control) ───────────────────────────────────────────
// Cleaning-specific QC. An Inspection is historical evidence: on finalize it
// snapshots the template (name + threshold) and each item (label/points/critical/
// photo) onto the result rows, and stores the computed score + outcome. Later
// template edits never change historical inspections.

enum InspectionStatus {
  DRAFT
  FINALIZED

  @@schema("cleaning")
}

enum InspectionOutcome {
  PASS
  FAIL

  @@schema("cleaning")
}

enum InspectionResultValue {
  PASS
  FAIL
  NA

  @@schema("cleaning")
}

model InspectionTemplate {
  id            String   @id @default(cuid())
  organizationId String
  name          String
  passThreshold Int      @default(80) // percent required to PASS
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        InspectionTemplateItem[]
  inspections  Inspection[]

  @@index([organizationId])
  @@schema("cleaning")
}

model InspectionTemplateItem {
  id           String   @id @default(cuid())
  templateId   String
  label        String
  instructions String?
  points       Int      @default(1)
  isCritical   Boolean  @default(false)
  requirePhoto Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  template InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@schema("cleaning")
}

model Inspection {
  id                String             @id @default(cuid())
  organizationId    String
  serviceLocationId String
  jobId             String? // Phase 4 prioritizes Job-linked; nullable enables future site inspections
  inspectorId       String
  templateId        String?
  templateName      String // snapshot
  passThreshold     Int // snapshot
  status            InspectionStatus   @default(DRAFT)
  score             Float? // stored at finalize; never recomputed from the template
  outcome           InspectionOutcome?
  comments          String?
  finalizedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceLocation ServiceLocation        @relation(fields: [serviceLocationId], references: [id], onDelete: Cascade)
  job             Job?                    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  inspector       User                    @relation("InspectionInspector", fields: [inspectorId], references: [id])
  template        InspectionTemplate?     @relation(fields: [templateId], references: [id])
  results         InspectionItemResult[]
  photos          JobPhoto[]
  issue           Issue?

  @@index([organizationId])
  @@index([serviceLocationId])
  @@index([jobId])
  @@schema("cleaning")
}

model InspectionItemResult {
  id           String                @id @default(cuid())
  inspectionId String
  // Snapshotted item data — historical, never re-derived from the template.
  label        String
  instructions String?
  points       Int
  isCritical   Boolean
  requirePhoto Boolean
  sortOrder    Int
  result       InspectionResultValue?
  note         String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  photos     JobPhoto[]

  @@index([inspectionId])
  @@schema("cleaning")
}

// ─── Billing: Invoices / AR (Phase 2) ────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String
  // Per-org sequential human number (rendered as e.g. INV-0001). Uniqueness is
  // enforced by @@unique below; generation retries on P2002, like job gen.
  invoiceNumber  Int
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  periodStart    DateTime
  periodEnd      DateTime
  currency       String        @default("USD")
  subtotal       Decimal       @db.Decimal(12, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(12, 2) // always 0 for now
  total          Decimal       @db.Decimal(12, 2)
  notes          String?
  emailedAt      DateTime? // last time it was emailed to the customer (Phase 7)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id])
  lines        InvoiceLine[]
  payments     InvoicePayment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@schema("cleaning")
}

model InvoiceLine {
  id        String @id @default(cuid())
  invoiceId String
  // Snapshot link to the job billed (NULL for ad-hoc lines). Immutable record.
  jobId     String?
  // Uniqueness guard: equals jobId while the invoice is non-VOID, set to NULL
  // when the invoice is voided — so a job appears on at most one non-VOID
  // invoice, but can be re-invoiced after a void. DB-enforced by @unique.
  activeJobId String? @unique
  // Snapshotted at generation — never re-derived from the plan/site/job.
  description String
  siteName    String?
  serviceDate DateTime
  quantity    Decimal  @db.Decimal(12, 2)
  unitRate    Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  job     Job?    @relation(fields: [jobId], references: [id])

  @@index([invoiceId])
  @@index([jobId])
  @@schema("cleaning")
}

model InvoicePayment {
  id           String   @id @default(cuid())
  invoiceId    String
  amount       Decimal  @db.Decimal(12, 2)
  receivedDate DateTime @default(now())
  method       String?
  reference    String?
  createdAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@schema("cleaning")
}

// ─── CRM: Lead → Estimate → Customer (Phase 5) ───────────────────────────────

model Lead {
  id             String     @id @default(cuid())
  organizationId String
  name           String // primary contact person
  company        String?
  email          String?
  phone          String?
  source         String? // free text: referral, website, cold call, …
  status         LeadStatus @default(NEW)
  notes          String?
  assignedToId   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("LeadAssignee", fields: [assignedToId], references: [id])
  estimates    Estimate[]

  @@index([organizationId])
  @@index([status])
  @@schema("cleaning")
}

model Estimate {
  id             String          @id @default(cuid())
  organizationId String
  leadId         String? // sourced from a lead …
  customerId     String? // … or written for an existing customer
  title          String
  // Prospect / site details — used to CREATE the customer + site on conversion.
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  siteName       String?
  addressLine1   String?
  city           String?
  state          String?
  postalCode     String?
  // Recurring service shape carried to the ServicePlan on conversion.
  frequency           ServiceFrequency @default(WEEKLY)
  pricing             EstimatePricing  @default(PER_VISIT)
  rate                Decimal?         @db.Decimal(12, 2) // per-visit price or hourly rate
  currency            String           @default("USD")
  checklistTemplateId String?
  // Document.
  status     EstimateStatus @default(DRAFT)
  validUntil DateTime?
  subtotal   Decimal        @default(0) @db.Decimal(12, 2)
  total      Decimal        @default(0) @db.Decimal(12, 2)
  notes      String?
  // Immutability link: once set the estimate is read-only and permanently
  // bound to the customer it created (snapshot pattern, like invoices).
  convertedCustomerId String?
  convertedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead              Lead?              @relation(fields: [leadId], references: [id])
  customer          Customer?          @relation("EstimateCustomer", fields: [customerId], references: [id])
  convertedCustomer Customer?          @relation("EstimateConvertedCustomer", fields: [convertedCustomerId], references: [id])
  checklistTemplate ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id])
  lines             EstimateLine[]

  @@index([organizationId])
  @@index([leadId])
  @@index([customerId])
  @@index([status])
  @@schema("cleaning")
}

model EstimateLine {
  id          String   @id @default(cuid())
  estimateId  String
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitRate    Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@schema("cleaning")
}

// ─── Assets & supplies (Phase 6) ─────────────────────────────────────────────
// Deliberately minimal: an asset record + a maintenance log; a supply stock
// level + a usage log + manual stock adjustments. NO purchasing/POs, vendors,
// depreciation, or maintenance scheduling.

model Asset {
  id               String        @id @default(cuid())
  organizationId   String
  name             String
  category         AssetCategory @default(EQUIPMENT)
  serial           String?
  purchaseDate     DateTime?
  purchaseCost     Decimal?      @db.Decimal(12, 2)
  status           AssetStatus   @default(ACTIVE)
  assignedToSiteId String?
  assignedToUserId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedToSite ServiceLocation?   @relation("AssetSite", fields: [assignedToSiteId], references: [id])
  assignedToUser User?              @relation("AssetUser", fields: [assignedToUserId], references: [id])
  maintenance    AssetMaintenance[]

  @@index([organizationId])
  @@index([status])
  @@schema("cleaning")
}

model AssetMaintenance {
  id            String   @id @default(cuid())
  assetId       String
  date          DateTime @default(now())
  type          String
  cost          Decimal? @db.Decimal(12, 2)
  notes         String?
  performedById String?
  createdAt     DateTime @default(now())

  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performedBy User? @relation("MaintenancePerformer", fields: [performedById], references: [id])

  @@index([assetId])
  @@schema("cleaning")
}

model Supply {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  unit             String   @default("unit")
  currentStock     Decimal  @default(0) @db.Decimal(12, 2)
  reorderThreshold Decimal  @default(0) @db.Decimal(12, 2)
  costPerUnit      Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usages       SupplyUsage[]
  adjustments  SupplyAdjustment[]

  @@index([organizationId])
  @@schema("cleaning")
}

model SupplyUsage {
  id                String   @id @default(cuid())
  organizationId    String
  supplyId          String
  quantity          Decimal  @db.Decimal(12, 2)
  jobId             String?
  serviceLocationId String?
  recordedById      String
  createdAt         DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supply          Supply           @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  job             Job?             @relation(fields: [jobId], references: [id])
  serviceLocation ServiceLocation? @relation("SupplyUsageSite", fields: [serviceLocationId], references: [id])
  recordedBy      User             @relation("SupplyUsageRecorder", fields: [recordedById], references: [id])

  @@index([organizationId])
  @@index([supplyId])
  @@index([jobId])
  @@schema("cleaning")
}

// Manual stock corrections/restocks with a reason — the sanctioned way to
// increase stock (no receipts/purchasing in this phase).
model SupplyAdjustment {
  id           String   @id @default(cuid())
  supplyId     String
  delta        Decimal  @db.Decimal(12, 2) // signed: + restock/correction, - shrinkage
  reason       String
  adjustedById String?
  createdAt    DateTime @default(now())

  supply     Supply @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  adjustedBy User?  @relation("SupplyAdjuster", fields: [adjustedById], references: [id])

  @@index([supplyId])
  @@schema("cleaning")
}

// ─── Contracts / service agreements (Phase 8) ────────────────────────────────
// A container for commercial terms — NOT a billing source. Invoicing still
// generates from jobs/service plans; a contract just holds the deal and lets us
// compare its value to actual invoiced revenue. Linking service plans is
// optional; a customer with plans and no contract is unaffected.
model Contract {
  id               String                   @id @default(cuid())
  organizationId   String
  customerId       String
  title            String
  startDate        DateTime
  endDate          DateTime?
  autoRenew        Boolean                  @default(false)
  contractValue    Decimal?                 @db.Decimal(12, 2)
  billingFrequency ContractBillingFrequency @default(MONTHLY)
  status           ContractStatus           @default(DRAFT)
  documentUrl      String? // reference to an external document — no upload/generation
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id])
  servicePlans ServicePlan[]

  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@schema("cleaning")
}
