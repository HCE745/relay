# ─── Database ─────────────────────────────────────────────────────────────────
# Transaction-mode pooler — used by the app at runtime (Vercel serverless functions).
# From: Supabase dashboard → Project Settings → Database → Connection string → Transaction
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Direct connection — used only by `prisma migrate` and `prisma db seed`.
# From: Supabase dashboard → Project Settings → Database → Connection string → URI
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# Maximum pool size for Prisma (default 10 — reduce if your DB has connection limits)
# DATABASE_POOL_MAX=10

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-character-secret"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# The "from" address — must be from a verified domain in your Resend account
EMAIL_FROM="Relay <noreply@yourdomain.com>"
# Base URL of your deployed app — used to build clickable issue links in emails
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
# Support and bug-report destination addresses
SUPPORT_EMAIL="support@yourdomain.com"
BUG_REPORT_EMAIL="bugs@yourdomain.com"

# ─── Email / IMAP ─────────────────────────────────────────────────────────────
# Inbound email webhook secret from Resend dashboard → Settings → Inbound
# Used to verify that inbound webhooks at /api/webhooks/crm-email came from Resend
RESEND_INBOUND_SECRET="your-resend-inbound-signing-secret"

# AES-256-GCM encryption key for IMAP passwords stored per super-admin
# Generate with:  openssl rand -base64 32
# Must be at least 32 characters — will be padded/truncated to 32 bytes
IMAP_ENCRYPTION_KEY="change-me-to-a-random-32-char-key"

# Secret for authenticating cron job requests (IMAP sync, billing credits, etc.)
# Generate with:  openssl rand -hex 32
# Set the same value in Vercel dashboard under Environment Variables
CRON_SECRET="your-cron-secret-here"

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get your keys at: https://dashboard.stripe.com/apikeys
# Secret key — server-side only, NEVER expose to the browser
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxx"
# Publishable key — safe to expose client-side
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxxxxxxxxxx"
# Webhook signing secret — from Stripe dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# Plan price IDs — create products + prices in Stripe, then paste their price IDs here
# Core plans
STRIPE_PRICE_WASH_ESSENTIALS="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_WASH_ESSENTIALS_LOCATION="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_ESSENTIALS="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_PROFESSIONAL="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_PROFESSIONAL_PLUS="price_xxxxxxxxxxxxxxxxxxxx"

# Location add-ons
STRIPE_PRICE_ADDITIONAL_LOCATION="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_PP_ADDITIONAL_LOCATION="price_xxxxxxxxxxxxxxxxxxxx"

# Employee-count tiers (Essentials / Professional)
STRIPE_PRICE_EMPLOYEES_51_100="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_EMPLOYEES_101_200="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_EMPLOYEES_201_350="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_EMPLOYEES_351_500="price_xxxxxxxxxxxxxxxxxxxx"

# Employee-count tiers (Professional Plus)
STRIPE_PRICE_PP_EMPLOYEES_251_500="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_PP_EMPLOYEES_501_1000="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_PP_EMPLOYEES_1001_2500="price_xxxxxxxxxxxxxxxxxxxx"

# Intelligence Module add-ons
STRIPE_PRICE_ISSUE_INTELLIGENCE="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_SOP_INTELLIGENCE="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_ASSET_INTELLIGENCE="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_BENCHMARK_INTELLIGENCE="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_PURCHASE_INTELLIGENCE="price_xxxxxxxxxxxxxxxxxxxx"
STRIPE_PRICE_INTELLIGENCE_SUITE="price_xxxxxxxxxxxxxxxxxxxx"

# ─── AI / Anthropic ───────────────────────────────────────────────────────────
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxx"

# ─── Relay MCP Server ─────────────────────────────────────────────────────────
# Authenticates Claude.ai → Relay CRM MCP connection at /api/mcp
# Generate with:  openssl rand -base64 32
# Must match the bearer token configured in Claude.ai → Settings → Integrations
# See MCP_SETUP.md for full connection instructions
MCP_API_KEY="change-me-to-a-random-32-char-key"

# ─── Firebase / Push Notifications ────────────────────────────────────────────
# Base64-encoded Firebase service account JSON.
# Get from: Firebase console → Project settings → Service accounts → Generate new private key
# Then encode:  base64 -w 0 firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64="eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwicHJvamVjdF9pZCI6InlvdXItcHJvamVjdCIsLi4ufQ=="

# ─── Integrations ─────────────────────────────────────────────────────────────
# Google Business Profile OAuth (Customer Voice feature)
# Create a project at: https://console.cloud.google.com/
# Enable: My Business Account Management API + My Business Information API + My Business API
# OAuth consent screen: add scope https://www.googleapis.com/auth/business.manage
# Create OAuth 2.0 credentials → Web application → add redirect URI below
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxx"
GOOGLE_REDIRECT_URI="https://app.getrelay.software/api/integrations/google/callback"

# AES-256-GCM key for encrypting Google OAuth tokens at rest.
# Generate with:  openssl rand -base64 32
CONNECTED_ACCOUNT_ENCRYPTION_KEY="change-me-to-a-random-32-char-key"

# Calendly webhook integration (demo scheduling)
# Get from: Calendly → Integrations → Webhooks
CALENDLY_WEBHOOK_SECRET="your-calendly-webhook-secret"
CALENDLY_API_KEY="your-calendly-api-key"

# ─── Upstash Redis (rate limiting / queuing) ───────────────────────────────────
# Create a database at: https://console.upstash.com/
# From the database details page → REST API section
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ─── Monitoring / Sentry ──────────────────────────────────────────────────────
# Create a project at: https://sentry.io/
# Auth token: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxxxxxxx"
SENTRY_ORG="your-sentry-org-slug"
SENTRY_PROJECT="your-sentry-project-slug"

# ─── Demo video generator (local only — never deployed to Vercel) ─────────────
# Primary TTS voice. Get API key + voice ID at: https://elevenlabs.io
# Voice ID: navigate to Voices → copy the ID of any cloned or library voice
ELEVENLABS_API_KEY="sk_xxxxxxxxxxxxxxxxxxxx"
ELEVENLABS_VOICE_ID="pNInz6obpgDQGcFmaJgB"

# Fallback TTS if ElevenLabs is unavailable. Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"
