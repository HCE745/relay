<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      SCAN_DELIVER permission: a custom signature-level permission that scanner vendor
      services CAN declare (and that IT admins can allow via MDM) to restrict who may
      deliver scan broadcasts to this app.

      In practice, most vendor scanner services (DataWedge, Honeywell Scan Wedge, etc.)
      do not hold custom application permissions, so we do NOT require this permission
      on the receivers — doing so would silently drop all vendor scan broadcasts.
      Instead this permission is declared for future use by IT-managed scanner config
      tools that want to send data to Relay explicitly.
    -->
    <permission
        android:name="io.getrelay.app.permission.SCAN_DELIVER"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: app.getrelay.software URLs open in-app -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="app.getrelay.software" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Declares that this app can receive Relay scan broadcasts (optional, for IT tooling) -->
    <uses-permission android:name="io.getrelay.app.permission.SCAN_DELIVER" />

    <!-- Camera is optional — the app works without a camera -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Physical keypad is not required -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

</manifest>
